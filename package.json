{
  "name": "critispare",
  "version": "1.0.0",
  "description": "Motor de criticidad de repuestos (Entropia + TOPSIS + k-means) y micro-SaaS estatica.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/interfaz.e2e.mjs",
    "test:excel": "python3 test/validar_kit_excel.py",
    "demo": "node scripts/generar-demo.mjs 120",
    "producto": "python3 scripts/generar_kit_excel.py 60",
    "licencia:par": "node scripts/licencia.mjs generar-par",
    "licencia:emitir": "node scripts/licencia.mjs emitir",
    "servir": "node -e \"const{createServer}=require('node:http'),{readFile}=require('node:fs/promises'),{join,extname}=require('node:path');const T={'.html':'text/html','.js':'text/javascript','.css':'text/css','.csv':'text/csv'};createServer(async(q,r)=>{try{const f=join('docs',q.url==='/'?'index.html':decodeURIComponent(q.url.split('?')[0]));const c=await readFile(f);r.writeHead(200,{'Content-Type':T[extname(f)]||'application/octet-stream'});r.end(c)}catch{r.writeHead(404).end()}}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.49.1",
    "xlsx": "^0.18.5"
  }
}