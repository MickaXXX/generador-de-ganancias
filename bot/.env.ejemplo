# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a  .env  y rellena lo tuyo.  El .env NO se sube a git.
# ─────────────────────────────────────────────────────────────────────────────

# 1) TELEGRAM  (obligatorio)
# Token: escribe a @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Tu id numerico: escribe a @userinfobot. Solo ese id puede dar ordenes al bot.
TELEGRAM_OWNER_ID=

# 2) BILLETERA  (obligatorio para operar de verdad)
# Frase con la que se cifra la clave privada en disco. Minimo 8 caracteres.
# Si la pierdes, pierdes el acceso al archivo (no a los fondos: guarda aparte la copia
# de la clave privada que te muestra "npm run wallet:nueva").
WALLET_PASSPHRASE=

# 3) RPC DE SOLANA
# La publica funciona para probar, pero es lenta y limita las consultas.
# Para copiar en serio consigue una propia: helius.dev, quicknode.com, triton.one
RPC_URL=https://api.mainnet-beta.solana.com
RPC_URL_BACKUP=

# 4) JUPITER (rutas de intercambio)
# Sin clave funciona, pero con muy pocas consultas por segundo.
# Pide una gratis en portal.jup.ag y ponla aqui.
JUPITER_BASE=https://api.jup.ag/swap/v1
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2
JUPITER_API_KEY=
# Si tu clave todavia no funciona, el endpoint sin clave es:
# JUPITER_BASE=https://lite-api.jup.ag/swap/v1
# JUPITER_TOKENS_BASE=https://lite-api.jup.ag/tokens/v2

# ─────────────────────────────────────────────────────────────────────────────
# 5) COMO SE COPIA  (todo esto se puede cambiar despues desde Telegram con /set)
# ─────────────────────────────────────────────────────────────────────────────

# simulacion = no gasta un peso, solo avisa lo que habria hecho. EMPIEZA AQUI.
MODO=simulacion

# fijo         -> siempre el mismo monto (COMPRA_USD)
# proporcional -> un porcentaje de lo que puso el lider (PROPORCION)
# patrimonio   -> un porcentaje de tu propio saldo (PATRIMONIO_PCT)
SIZING_MODO=fijo
COMPRA_USD=4
PROPORCION=0.004
PATRIMONIO_PCT=2
COMPRA_MIN_USD=1
COMPRA_MAX_USD=25

# ── Riesgo ───────────────────────────────────────────────────────────────────
SLIPPAGE_BPS=150            # 150 = 1.5% al comprar
SLIPPAGE_VENTA_BPS=300      # mas holgado al vender: salir importa mas que el precio
IMPACTO_MAX_PCT=8           # si tu propia compra mueve el precio mas que esto, no compra
PRIORITY_FEE_MAX_LAMPORTS=2000000
MAX_POSICIONES=8
MAX_COMPRAS_DIA=25
PERDIDA_DIA_MAX_USD=25      # al llegar a esta perdida, deja de comprar por hoy
RESERVA_SOL=0.02            # SOL que nunca se gasta, para comisiones
COOLDOWN_MINT_MIN=30
PROMEDIAR=false

# ── Salidas automaticas ──────────────────────────────────────────────────────
# TAKE_PROFIT debe ser mayor que TRAILING_ACTIVA para que los dos sirvan.
TAKE_PROFIT_PCT=60
STOP_LOSS_PCT=35
TRAILING_ACTIVA_PCT=40      # desde +40% empieza a proteger la ganancia
TRAILING_CAIDA_PCT=15       # y vende si cae 15% desde el punto mas alto
VENDER_SI_VENDE_LIDER=true
FRACCION_VENTA_DESCONOCIDA=1  # si no viste su compra y el vende: 1 = vender todo

# ── Vigilancia ───────────────────────────────────────────────────────────────
POLL_MS=2500                # cada cuanto pregunta por operaciones nuevas
MONITOR_MS=20000            # cada cuanto revisa take profit / stop loss / trailing
MAX_EDAD_SENAL_S=90         # una senal mas vieja que esto ya no se copia
LOG_NIVEL=info
